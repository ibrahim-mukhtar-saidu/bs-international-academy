// BS INTERNATIONAL ACADEMY
// Academic Foundation Schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SectionType {
  NURSERY
  PRIMARY
  JUNIOR_SECONDARY
  SENIOR_SECONDARY
}

model School {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  website   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions         AcademicSession[]
  sections         Section[]
  classes          SchoolClass[]
  subjects         Subject[]
  users            User[]
  teacherProfiles  TeacherProfile[]
  studentProfiles  StudentProfile[]
  parentProfiles   ParentProfile[]
  timetablePeriods TimetablePeriod[]
  examinations     Examination[]
}

model AcademicSession {
  id        String   @id @default(cuid())
  name      String
  startYear Int
  endYear   Int
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  terms              Term[]
  classes            SchoolClass[]
  studentProfiles    StudentProfile[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  assessments        Assessment[]
  examinations       Examination[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Term {
  id        String   @id @default(cuid())
  name      String
  number    Int
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessionId    String
  session      AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assessments  Assessment[]
  examinations Examination[]

  @@unique([sessionId, number])
  @@index([sessionId])
}

model Section {
  id        String      @id @default(cuid())
  name      String
  type      SectionType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classes SchoolClass[]

  @@unique([schoolId, type])
  @@index([schoolId])
}

model SchoolClass {
  id        String   @id @default(cuid())
  name      String
  code      String
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sectionId String
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  sessionId          String
  session            AcademicSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentProfiles    StudentProfile[]
  teacherAssignments TeacherAssignment[]
  timetableEntries   TimetableEntry[]
  assessments        Assessment[]
  examinations       Examination[]

  @@unique([schoolId, code, sessionId])
  @@index([schoolId])
  @@index([sectionId])
  @@index([sessionId])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherAssignments TeacherAssignment[]
  examinationScores  ExaminationScore[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

enum UserRole {
  ADMIN
  PRINCIPAL
  TEACHER
  STUDENT
  PARENT
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?

  @@index([schoolId])
  @@index([schoolId, role])
  @@index([schoolId, status])
}

model TeacherProfile {
  id         String   @id @default(cuid())
  employeeNo String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  assignments      TeacherAssignment[]
  timetableEntries TimetableEntry[]

  @@unique([schoolId, employeeNo])
  @@index([schoolId])
}

model TeacherAssignment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  sessionId        String
  session          AcademicSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]
  assessments      Assessment[]

  @@unique([teacherId, subjectId, classId, sessionId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@index([sessionId])
}

model StudentProfile {
  id          String    @id @default(cuid())
  admissionNo String
  dateOfBirth DateTime?
  gender      String?
  address     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classId     String?
  schoolClass SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)

  sessionId String?
  session   AcademicSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  parents           ParentStudent[]
  assessmentScores  AssessmentScore[]
  examinationScores ExaminationScore[]

  @@unique([schoolId, admissionNo])
  @@index([schoolId])
  @@index([classId])
  @@index([sessionId])
}

model ParentProfile {
  id           String   @id @default(cuid())
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  children ParentStudent[]

  @@index([schoolId])
}

model ParentStudent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  parentId String
  parent   ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model TimetablePeriod {
  id        String   @id @default(cuid())
  name      String
  startTime String
  endTime   String
  order     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  entries TimetableEntry[]

  @@unique([schoolId, order])
  @@index([schoolId])
}

model TimetableEntry {
  id        String    @id @default(cuid())
  day       DayOfWeek
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  periodId String
  period   TimetablePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  assignmentId String
  assignment   TeacherAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([sessionId, classId, day, periodId])
  @@unique([sessionId, teacherId, day, periodId])
  @@index([sessionId])
  @@index([classId])
  @@index([periodId])
  @@index([assignmentId])
  @@index([teacherId])
}

enum AssessmentType {
  ASSIGNMENT
  TEST
}

model Assessment {
  id          String         @id @default(cuid())
  title       String
  description String?
  type        AssessmentType
  maxScore    Decimal        @db.Decimal(6, 2)
  dueDate     DateTime?
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  teacherAssignmentId String
  teacherAssignment   TeacherAssignment @relation(fields: [teacherAssignmentId], references: [id], onDelete: Cascade)

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  termId String?
  term   Term?   @relation(fields: [termId], references: [id], onDelete: SetNull)

  scores AssessmentScore[]

  @@index([teacherAssignmentId])
  @@index([sessionId])
  @@index([classId])
  @@index([termId])
  @@index([type])
  @@index([isPublished])
}

model AssessmentScore {
  id        String   @id @default(cuid())
  score     Decimal  @db.Decimal(6, 2)
  feedback  String?
  gradedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([assessmentId])
  @@index([studentId])
}

model Examination {
  id          String   @id @default(cuid())
  name        String
  description String?
  maxScore    Decimal  @db.Decimal(6, 2)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  sessionId String
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  classId     String
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  scores ExaminationScore[]

  @@index([schoolId])
  @@index([sessionId])
  @@index([termId])
  @@index([classId])
}

model ExaminationScore {
  id        String   @id @default(cuid())
  score     Decimal  @db.Decimal(6, 2)
  feedback  String?
  gradedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  examinationId String
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)

  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([examinationId, studentId, subjectId])
  @@index([examinationId])
  @@index([studentId])
  @@index([subjectId])
}
